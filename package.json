{
  "name": "telegator",
  "version": "1.0.2",
  "private": true,
  "description": "Telegram news pipeline on Firebase",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "export PORT=8080; npm run stop && npm -w tg-functions run build && npx --yes npm-run-all --parallel dev:*",
    "build": "tsx scripts/web.ts && npm -w tg-functions run build",
    "gates": "npx --yes npm-run-all --parallel --continue-on-error --aggregate-output typecheck test lint",
    "typecheck": "tsc --noEmit",
    "test": "firebase emulators:exec --only firestore,auth --project demo-telegator 'vitest run'",
    "lint": "biome check .",
    "format": "biome check --write .",
    "deploy": "npm run build && firebase deploy",
    "cursors:now": "tsx scripts/set-cursors-now.ts --write",
    "migrate:source-type": "tsx scripts/migrate-source-type.ts",
    "autofix": "tsx scripts/autofix.ts",
    "mcp": "tsx scripts/mcp.ts",
    "codegen:cml-catalog": "bun ../proton/ops/generate-catalog.ts packages/tg-web/cml",
    "mtproto:login": "export TG_API_ID=$(. ~/.keys/.env; echo $TG_API_ID) TG_API_HASH=$(. ~/.keys/.env; echo $TG_API_HASH) && tsx scripts/mtproto-login.ts",
    "youtube:login": "export YT_CLIENT_ID=$(. ~/.keys/.env; echo $TELEGATOR_OAUTH_DESKTOP_CLIENT_KEY) YT_CLIENT_SECRET=$(. ~/.keys/.env; echo $TELEGATOR_OAUTH_DESKTOP_CLIENT_SECRET) && tsx scripts/youtube-login.ts",
    "youtube:absorb": "tsx scripts/youtube-absorb.ts",
    "smoke:openrouter": "export OPENROUTER_API_KEY=$(. ~/.keys/.env; echo $OPENROUTER_API_KEY) && tsx scripts/smoke-openrouter.ts",
    "postinstall": "../proton/ops/link-modules.sh arrmatura arrmatura-web arrmatura-vibe ultimus",
    "dev:functions": "npm -w tg-functions run watch",
    "dev:emulators": "./scripts/emulators.sh",
    "dev:web": "tsx scripts/web.ts --serve",
    "dev:vibe": "bun node_modules/arrmatura-vibe/src/server/main.ts . 8091",
    "dev:open": "npx --yes wait-on http-get://127.0.0.1:4000 && npm run seed:upload:dev -- --write && npm run open",
    "open": "npx --yes wait-on http://localhost:${PORT:-8080} && open http://localhost:${PORT:-8080}",
    "stop": "lsof -t -sTCP:LISTEN -i tcp:${PORT:-8080},8091,9099,9199,5000,5001,8180,4000 | xargs -r kill -9",
    "seed:download:prod": "tsx scripts/seed.ts download prod --write",
    "seed:download:dev": "tsx scripts/seed.ts download dev --write",
    "seed:upload:dev": "tsx scripts/seed.ts upload dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "telegram": "^2.26.22",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/cli": "4.1.14",
    "@types/node": "^26.4.0",
    "daisyui": "5.0.0-beta.9",
    "esbuild": "^0.25.10",
    "tailwindcss": "4.1.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}

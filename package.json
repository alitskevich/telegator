{
  "name": "telegator",
  "version": "1.0.2",
  "private": true,
  "description": "Telegram news pipeline on AWS",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm -w tg-web run dev",
    "start": "npm -w tg-web run start",
    "build": "npm -w tg-web run build",
    "gates": "npx --yes npm-run-all --parallel --continue-on-error --aggregate-output typecheck test lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed HEAD",
    "lint": "biome check .",
    "format": "biome check --write .",
    "synth": "cdk synth",
    "deploy": "tsx scripts/deploy.ts --execute",
    "scrape": "tsx scripts/scrape.ts",
    "cursors:now": "tsx scripts/set-cursors-now.ts --write",
    "migrate:targets": "tsx scripts/migrate-targets.ts --write",
    "mcp": "tsx scripts/mcp.ts",
    "mtproto:login": "export TG_API_ID=$(cat $HOME/.keys/tg-api-id.key) TG_API_HASH=$(cat $HOME/.keys/tg-api-hash.key) && tsx scripts/mtproto-login.ts",
    "smoke:openrouter": "export OPENROUTER_API_KEY=$(cat $HOME/.keys/openrouter-api.key) && tsx scripts/smoke-openrouter.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@aws-sdk/client-cloudwatch": "^3.1121.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1121.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1121.0",
    "@aws-sdk/client-dynamodb": "^3.1121.0",
    "@aws-sdk/client-lambda": "^3.1121.0",
    "@aws-sdk/client-secrets-manager": "^3.1121.0",
    "@aws-sdk/client-sqs": "^3.1121.0",
    "@aws-sdk/client-sts": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1121.0",
    "jose": "^6.2.10",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "telegram": "^2.26.22",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "aws-cdk": "^2.1139.0",
    "aws-cdk-lib": "^2.267.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.8.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}

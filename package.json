{
  "name": "telegator",
  "version": "1.0.2",
  "private": true,
  "description": "Telegram news pipeline on Firebase",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "export PORT=8080; npm run stop && npm -w tg-functions run build && npx --yes npm-run-all --parallel dev:*",
    "build": "tsx scripts/web.ts && npm -w tg-functions run build",
    "gates": "npx --yes npm-run-all --parallel --continue-on-error --aggregate-output typecheck test lint",
    "typecheck": "tsc --noEmit",
    "test": "firebase emulators:exec --only firestore,auth --project demo-telegator 'vitest run'",
    "lint": "biome check .",
    "format": "biome check --write .",
    "deploy": "npm run build && firebase deploy",
    "cursors:now": "tsx scripts/set-cursors-now.ts --write",
    "autofix": "tsx scripts/autofix.ts",
    "mcp": "tsx scripts/mcp.ts",
    "mtproto:login": "export TG_API_ID=$(cat $HOME/.keys/tg-api-id.key) TG_API_HASH=$(cat $HOME/.keys/tg-api-hash.key) && tsx scripts/mtproto-login.ts",
    "youtube:login": "export YT_CLIENT_ID=$(cat $HOME/.keys/yt-client-id.key) YT_CLIENT_SECRET=$(cat $HOME/.keys/yt-client-secret.key) && tsx scripts/youtube-login.ts",
    "youtube:absorb": "tsx scripts/youtube-absorb.ts",
    "gmail:login": "export GOOGLE_CLIENT_ID=$(cat $HOME/.keys/yt-client-id.key) GOOGLE_CLIENT_SECRET=$(cat $HOME/.keys/yt-client-secret.key) && tsx scripts/gmail-login.ts",
    "smoke:openrouter": "export OPENROUTER_API_KEY=$(cat $HOME/.keys/openrouter-api.key) && tsx scripts/smoke-openrouter.ts",
    "postinstall": "./scripts/link-packages.sh arrmatura arrmatura-web ultimus",
    "dev:functions": "npm -w tg-functions run watch",
    "dev:emulators": "./scripts/emulators.sh",
    "dev:web": "tsx scripts/web.ts --serve && npm run open",
    "open": "npx --yes wait-on http://localhost:${PORT:-8080} && open http://localhost:${PORT:-8080}",
    "stop": "lsof -t -sTCP:LISTEN -i tcp:${PORT:-8080},9099,9199,5000,5001,8180,4000 | xargs -r kill -9",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "telegram": "^2.26.22",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/cli": "4.1.14",
    "@types/node": "^26.4.0",
    "daisyui": "5.0.0-beta.9",
    "esbuild": "^0.25.10",
    "tailwindcss": "4.1.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}

# dependencies
node_modules/

# build output
.next/
out/
dist/
cdk.out/
*.tsbuildinfo

# environment
.env*
# — except the documented template, which holds names and ARNs, never a value.
!.env.local.example
# Local API keys. Unlike everything in .env.local.example these ARE secrets, and
# `.env*` does not cover a name that does not start with `.env`.
.orkey
*.key
.secrets/

# ralph loop working files (the user's, and the ledger)
.claude/*.local.md

# os
.DS_Store

# the operator's export, staged here to be read by scripts/seed.ts.
# R21: it lives outside this repository — it is operational data, not source,
# and biome (vcs.useIgnoreFile) must not format someone else's export.
data/
.spectomat/state.md
.spectomat/work/
.spectomat/log.md

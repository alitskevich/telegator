<Component id="Page.Pipeline">
  <Signature purpose="The whole pipeline as one live diagram, with every manual trigger on the node it acts on"
    description="Select a stage; its panel below holds its figures and its actions. Figures refresh every 30 s." />

  <PipelineService Ref="pipeline" api="@api" />

  <PageTitle title="{R.pipeline.title}" subtitle="{R.pipeline.subtitle}">
    <span class="text-xs text-base-content/60">{R.common.updated} {@pipeline.updatedAt | clock}</span>
    <Btn class="sm:btn-sm" mode="soft" icon="refresh-cw" text="{R.common.refresh}"
      busy="{@pipeline.loading}" click="-> @pipeline.load()" />
  </PageTitle>

  <ErrorBanner If="@pipeline.error" text="{@pipeline.error}" />

  <div class="grid gap-4 lg:grid-cols-2 lg:items-start">
    <section class="bg-base-100 rounded-box p-4 sm:p-6">
      <ol class="flex flex-col items-center max-w-sm mx-auto">
        <li Each="node of @pipeline.nodes" class="w-full flex flex-col items-center">
          <span If="!node.first" aria-hidden="true"
            class="icon icon-arrow-down py-1 text-base-content/40"></span>
          <PipelineNode node="{node}" select="-> @pipeline.select(event)" />
        </li>
      </ol>
    </section>

    <div class="lg:sticky lg:top-20">
      <PipelinePanel />
    </div>
  </div>
</Component>

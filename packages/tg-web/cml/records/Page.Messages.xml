<Component id="Page.Messages">
  <Signature purpose="The Messages table by status, picked from a radio group with each status's count, with Publish now on the backlog for an admin"
    description="The status is `?status=` in the url, so a reload or a shared link shows the same one." />

  <GridService Ref="grid" table="messages" status="{@browser.params.status}" api="@api"
    canEdit="{@api.canEdit}" />

  <PageTitle title="{R.tables.messages.title}">
    <Fragment If="{@api.canAdmin AND @grid.status == 'topublish'}">
      <label class="input sm:input-sm w-44">
        <span class="text-base-content/60">{R.pipeline.publishMax}</span>
        <input type="number" min="1" max="10" class="grow" value="{@grid.publishMax}"
          input="-> @grid.setPublishMax(event)" />
      </label>
      <Btn class="sm:btn-sm" type="primary" icon="send" text="{R.pipeline.publishNow}"
        busy="{@api.busy.publishPending}" click="-> @grid.publishNow()" />
    </Fragment>
  </PageTitle>

  <RadioGroup class="flex-wrap" size="sm" name="status" options="{@grid.statusOptions}" value="{@grid.status}"
    change="-> @browser.setParam('status', event.value || null)" />

  <RecordsTable table="messages" />
</Component>

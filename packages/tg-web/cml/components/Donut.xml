<Component id="Donut">
  <Signature purpose="Parts of a whole as one stacked bar, with a legend in the same order"
    description="`chart` is `{ slices }` from `PipelineService`: each part a flex item sized by its value, in a slate step from `tg-utils/ui/pie`. An empty chart says so rather than drawing an empty bar.">
    <Prop id="title" type="string" required="true" />
    <Prop id="chart" type="object" required="true" />
    <Prop id="empty" type="string" description="What an empty chart says" />
  </Signature>

  <section class="bg-base-100 rounded-box p-4 flex flex-col gap-4 min-w-0">
    <h2 class="text-lg font-semibold">{title}</h2>
    <Fragment If="chart.slices.length">
      <Then>
        <div class="flex h-6 gap-0.5 rounded-field overflow-hidden" role="img" aria-label="{title}">
          <span Each="slice of chart.slices" class="min-w-0.5" title="{slice.label}"
            style="flex: {slice.value} 1 0%; background: {slice.color}"></span>
        </div>
        <ul class="min-w-0 w-full flex flex-col gap-1.5 text-sm">
          <li Each="slice of chart.slices" class="flex items-center gap-2">
            <span class="size-2.5 rounded-sm shrink-0" style="background: {slice.color}"></span>
            <span class="flex-1 truncate">{slice.label}</span>
            <span class="text-base-content/70">{slice.value | num}</span>
            <span class="w-10 text-end text-base-content/70">{slice.fraction | share}</span>
          </li>
        </ul>
      </Then>
      <Else>
        <p class="text-sm text-base-content/70 py-10">{empty}</p>
      </Else>
    </Fragment>
  </section>
</Component>

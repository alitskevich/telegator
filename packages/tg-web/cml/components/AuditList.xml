<Component id="AuditList">
  <Signature purpose="What went wrong, one per line: when and where, then the reason. A rejected send names its target and method; a failed item, its stage and post">
    <Prop id="entries" type="array" required="true" description="`StoredAuditEntry` rows from `tg-firebase`, newest first" />
    <Prop id="withMessage" type="boolean" default="false" description="Also names each rejected send's message, for a list across messages" />
  </Signature>

  <ul class="flex flex-col divide-y divide-base-300/60 text-sm min-w-0">
    <li Each="entry of entries" class="py-2 first:pt-0 last:pb-0 flex flex-col gap-0.5 min-w-0">
      <span class="text-xs text-base-content/60 tabular-nums break-words">
        {entry.at | dateTimeFormat} ·
        <Fragment If="{entry.kind == 'item'}">
          <Then><span>{entry.stage} · {entry.ref}</span></Then>
          <Else>
            @{entry.target} · {entry.method}
            <span If="withMessage"> · {entry.messageId}</span>
          </Else>
        </Fragment>
      </span>
      <span class="text-error break-words">{entry.error}</span>
      <details If="entry.cause" class="text-xs">
        <summary class="cursor-pointer text-base-content/60">{R.pipeline.cause}</summary>
        <pre class="mt-1 whitespace-pre-wrap break-all">{entry.cause}</pre>
      </details>
    </li>
  </ul>
</Component>

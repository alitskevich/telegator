<Component id="Page.SignIn">
  <Signature purpose="The signed-out screen: what this is, and the one way in" />

  <div class="min-h-screen grid place-items-center px-4">
    <section class="w-full max-w-md bg-base-100 rounded-box p-8 flex flex-col gap-6">
      <div class="flex items-center gap-3">
        <span class="icon icon-radio-tower text-3xl text-primary" aria-hidden="true"></span>
        <span class="text-xl font-semibold">{R.app.name}</span>
      </div>
      <div class="flex flex-col gap-2">
        <h1 class="text-3xl font-semibold tracking-tight">{R.auth.signInTitle}</h1>
        <p class="text-base-content/70 text-pretty">{R.auth.signInBody}</p>
      </div>
      <Btn type="primary" icon="log-in" text="{R.auth.signIn}" busy="{@auth.busy}" click="-> @auth.signIn()" />
    </section>
  </div>
</Component>

{
  "name": "tg-seed",
  "version": "1.0.0",
  "description": "Snapshots of the operator-curated collections: download to JSON, upload back.",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "download:prod": "tsx scripts/seed.ts download prod --write",
    "download:dev": "tsx scripts/seed.ts download dev --write",
    "upload:dev": "tsx scripts/seed.ts upload dev"
  },
  "dependencies": {
    "tg-firebase": "*"
  }
}
